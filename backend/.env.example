# Server Configuration
PORT=4000

# MongoDB URI (default for local setup)
MONGODB_URI=mongodb://localhost:27017/veda-ai

# Redis Configuration (default for local setup)
REDIS_URL=redis://localhost:6379

# Google Gemini API Key
GEMINI_API_KEY=

# Enable Mock AI Fallback (true to bypass calling Gemini and return dynamic mock outputs for easy testing)
USE_MOCK_AI=true
